FUEL_INSIGHT_DATA_DIR=/var/lib/fuel-insight
FUEL_INSIGHT_INPUT_DIR=/var/lib/fuel-insight/inbox
FUEL_INSIGHT_OUTPUT_DIR=/var/lib/fuel-insight/outbox
FUEL_INSIGHT_PROCESSED_DIR=/var/lib/fuel-insight/processed
FUEL_INSIGHT_FAILED_DIR=/var/lib/fuel-insight/failed
FUEL_INSIGHT_ARCHIVE_DIR=/var/lib/fuel-insight/archiwum
FUEL_INSIGHT_DRIVER_MAPPING=/etc/fuel-insight/kierowcy.json
FUEL_INSIGHT_DB_CONFIG=/etc/fuel-insight/database.json
FUEL_INSIGHT_LOG_FILE=/var/log/fuel-insight/app.log
FUEL_INSIGHT_LOG_LEVEL=INFO
FUEL_INSIGHT_WEB_HOST=0.0.0.0
FUEL_INSIGHT_WEB_PORT=8000
FUEL_INSIGHT_WEB_MAX_UPLOAD_MB=100
FUEL_INSIGHT_REQUIRE_DB=1
FUEL_INSIGHT_POLL_INTERVAL=60
FUEL_INSIGHT_MIN_DISTANCE=100
FUEL_INSIGHT_EXPORT_CSV=1
